# console.groq.com API key, used server-side only by app/api/analyze/route.js
GROQ_API_KEY=

# Google Safe Browsing API key (console.cloud.google.com, enable "Safe Browsing API").
# Optional: used only when a message is JUST a link with no other text - if
# unset, link-only messages fall back to the normal AI pipeline.
GOOGLE_SAFE_BROWSING_API_KEY=
